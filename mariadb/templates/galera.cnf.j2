[galera]
binlog_format = row
default_storage_engine = InnoDB
innodb_autoinc_lock_mode = 2
bind-address = 0.0.0.0

log_error = /var/log/mysql/mysql.log
log_bin = mysql-bin
expire_logs_days = 7

key_buffer_size = 64M
max_heap_table_size = 64M
tmp_table_size = 64M

wsrep_on = ON
wsrep_cluster_name = "MariaDB-Galera-Cluster"
wsrep_provider = /usr/lib/galera/libgalera_smm.so
wsrep_cluster_address = "gcomm://{{ groups['database'] | map('extract', hostvars, 'ansible_host') | join(',') }}"
wsrep_sst_method = mariabackup
wsrep_sst_auth = "root:{{ mariadb_root_password }}"
wsrep_node_address = "{{ hostvars[inventory_hostname]['ansible_host'] }}"
wsrep_node_name = "{{ ansible_hostname }}"