[Unit]
Description=Apache Superset Webserver
After=network.target

[Service]
User={{ superset_user }}
Group={{ superset_user }}
WorkingDirectory={{ superset_home_dir }}
Environment="FLASK_APP=superset"
Environment="SUPERSET_CONFIG_PATH={{ superset_config_path }}"
Environment="SUPERSET_SECRET_KEY={{ superset_secret_key }}"

ExecStart={{ superset_venv_dir }}/bin/gunicorn \
          --workers {{ superset_gunicorn_workers }} \
          --timeout {{ superset_gunicorn_timeout }} \
          --bind 127.0.0.1:{{ superset_port }} \
          "superset.app:create_app()"
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target